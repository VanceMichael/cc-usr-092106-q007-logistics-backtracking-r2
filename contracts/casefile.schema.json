{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "跨省物流倒查案卷",
  "type": "object",
  "required": ["domain", "version", "case_id", "waybills"],
  "properties": {
    "domain": { "const": "logistics-backtracking" },
    "version": { "type": "integer", "minimum": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "phone_masked"],
        "properties": {
          "id": { "type": "string" },
          "phone_masked": { "type": "string", "pattern": "\\*+" },
          "platform": { "type": "string" },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "addresses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "code", "province", "city"],
        "properties": {
          "id": { "type": "string" },
          "code": { "type": "string" },
          "province": { "type": "string" },
          "city": { "type": "string" },
          "detail_masked": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "carrier", "code", "name", "province", "city"],
        "properties": {
          "id": { "type": "string" },
          "carrier": { "type": "string" },
          "code": { "type": "string" },
          "name": { "type": "string" },
          "province": { "type": "string" },
          "city": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "vehicle_batches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "carrier", "batch_no", "depart_at", "from_node_id", "to_node_id"],
        "properties": {
          "id": { "type": "string" },
          "carrier": { "type": "string" },
          "batch_no": { "type": "string" },
          "depart_at": { "type": "string" },
          "from_node_id": { "type": "string" },
          "to_node_id": { "type": "string" },
          "crosses_province": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "pieces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "weight_g"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "weight_g": { "type": "integer", "minimum": 0 },
          "medicine_lot": { "type": "string" },
          "from_sale_id": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "boxes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "weight_g": { "type": ["integer", "null"] },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "sales": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "at", "buyer_nick"],
        "properties": {
          "id": { "type": "string" },
          "at": { "type": "string" },
          "buyer_nick": { "type": "string" },
          "piece_ids": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "authorizations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "carrier", "granted_by", "granted_at"],
        "properties": {
          "id": { "type": "string" },
          "carrier": { "type": "string" },
          "granted_by": { "type": "string" },
          "granted_at": { "type": "string" },
          "scope_waybill_ids": { "type": "array", "items": { "type": "string" } },
          "scope_node_ids": { "type": "array", "items": { "type": "string" } },
          "expires_at": { "type": ["string", "null"] },
          "revoked": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "waybills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "events"],
        "properties": {
          "id": { "type": "string" },
          "events": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["seq", "type", "at", "source"],
              "properties": {
                "seq": { "type": "integer", "minimum": 1 },
                "waybill_id": { "type": "string" },
                "type": {
                  "enum": [
                    "registered", "correction", "cancelled", "forwarded",
                    "rejected", "signed", "partially_signed", "scan",
                    "vehicle_batch", "packed", "unpacked", "merged",
                    "query_receipt"
                  ]
                },
                "at": { "type": "string" },
                "source": { "type": "string" },
                "payload": { "type": "object" },
                "fields": { "type": "object" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
